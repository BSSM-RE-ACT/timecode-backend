# 복사해서 사용: cp .env.example .env
ENV=local
TZ=Asia/Seoul

# docker compose 안에서는 docker-compose.yml이 호스트를 db / redis 로 덮어씀
DATABASE_URL=postgresql+psycopg://timecode:timecode@localhost:5432/timecode
REDIS_URL=redis://localhost:6379/0

# 인증
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=bssm.hs.kr
ROOT_ADMIN_EMAILS=

# 프론트 주소 (CORS)
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
EXTRA_CORS_ORIGINS=

MAX_PERIOD=7
